# API del backend. En LAN (probar desde el celular) va la IP de la maquina.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Slug del negocio que se pre-carga en el login. La Staff NO lleva el tenant en la
# URL (sale del token); esto es solo el valor inicial del campo, editable.
NEXT_PUBLIC_DEFAULT_TENANT=bar-la-esquina
