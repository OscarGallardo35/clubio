# Copiar a .env.local para desarrollo.
# El backend corre en el puerto 3000; la PWA Cliente en el 3001.

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Clave publica VAPID para las notificaciones push (sale de GET /api/push/vapid-public-key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Negocio por defecto cuando no se puede resolver el tenant (solo desarrollo:
# en produccion el tenant viene del segmento [tenant] o del subdominio)
NEXT_PUBLIC_DEFAULT_TENANT=bar-la-esquina
