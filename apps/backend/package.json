{
  "name": "@mi-saas/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NestJS para SaaS de fidelización gastronómica",
  "author": "Oscar",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist tsconfig.tsbuildinfo",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "rimraf dist tsconfig.tsbuildinfo",
    "start": "nest start",
    "prestart:dev": "rimraf dist tsconfig.tsbuildinfo",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test:checklist": "node scripts/checklist-multisucursal.js",
    "test:aislamiento": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-aislamiento-modificadores.cjs",
    "test:pin": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-pin-duplicado.cjs",
    "test:cancelar": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-cancelar-link.cjs",
    "test:pedido-activo": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-pedido-activo.cjs",
    "test:auto-cancelar": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-auto-cancelar.cjs",
    "test:ws-cancelado": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-ws-cancelado-cliente.cjs",
    "test:hibrido": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-hibrido.cjs",
    "test:config-admin": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-config-admin.cjs",
    "test:auth-dueno": "dotenv -e ../../.env -e ../../.env.secrets -- node scripts/check-auth-dueno.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed && dotenv -e ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "test:e2e:s3": "dotenv -e ../../.env -- node e2e_s3.cjs",
    "test:e2e:s4": "dotenv -e ../../.env -- node e2e_s4.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/validators": "workspace:*",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.7.0",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@repo/config": "workspace:*",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.0.0",
    "@types/passport-google-oauth20": "^2.0.10",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^2.0.12",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "rimraf": "^5.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}