# ============ GENERAL ============
NODE_ENV=development

# ============ BACKEND ============
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mi_saas?schema=public
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/mi_saas?schema=public
# Conexión directa (sin pooler) usada por Prisma para las migraciones.
# En Neon: mismo DSN que DATABASE_URL pero quitando "-pooler" del host.
# En local alcanza con repetir el valor de DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mi_saas?schema=public
REDIS_URL=redis://localhost:6379

# ============ ENCRIPTACIÓN ============
# ENCRYPTION_KEY debe tener EXACTAMENTE 32 bytes (64 chars en hex)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generar-con-el-comando-de-arriba

# ============ JWT SUPER-ADMIN ============
# DISTINTO de los demas. Mismo comando: randomBytes(32).toString('hex').
JWT_SUPER_ADMIN_SECRET=generar-con-el-comando-de-arriba
JWT_SUPER_ADMIN_EXPIRES_IN=2h
JWT_SUPER_ADMIN_REFRESH_EXPIRES_IN=7d

# ============ SUPER-ADMIN ============
SUPER_ADMIN_INITIAL_EMAIL=admin@fideliza.app
SUPER_ADMIN_INITIAL_PASSWORD=cambiar-en-produccion

# ============ EMAIL ============
EMAIL_PROVIDER=smtp
EMAIL_FROM="Fideliza <no-reply@fideliza.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ============ JWT ============
# IMPORTANTE: cada secreto debe ser DISTINTO y aleatorio (64 chars hex).
# Si son iguales, un token de cliente valida contra el secreto de dueno y la
# unica barrera que queda es el claim `tipo`.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generar-con-el-comando-de-arriba
JWT_EMPLEADO_SECRET=generar-con-el-comando-de-arriba
JWT_DUENO_SECRET=generar-con-el-comando-de-arriba
JWT_CLIENTE_SECRET=generar-con-el-comando-de-arriba
JWT_REFRESH_SECRET=generar-con-el-comando-de-arriba
JWT_EMPLEADO_EXPIRES_IN=12h
JWT_DUENO_EXPIRES_IN=7d
JWT_CLIENTE_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dominio.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_PUBSUB_TOPIC=
# Token compartido que Pub/Sub envia como ?token= ; validar con timingSafeEqual
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PLACES_API_KEY=

# ============ PWA CLIENTE ============
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_PLACES_API_KEY=
NEXT_PUBLIC_DEFAULT_TENANT=bar-slug

# ============ PWA STAFF ============
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_DEFAULT_TENANT=bar-slug
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============ PWA ADMIN ============
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_PLACES_API_KEY=
NEXT_PUBLIC_DEFAULT_TENANT=bar-slug
NEXT_PUBLIC_APP_VERSION=1.0.0
# URL de la PWA Staff: base del link corto del pedido
STAFF_APP_URL=https://staff.dominio.com

# ============ RATE LIMITING (pedidos) ============
# POST /pedidos: por defecto 10 por hora por IP
RATE_PEDIDOS_CREATE_LIMIT=10
RATE_PEDIDOS_CREATE_TTL_MS=3600000
# GET /pedidos/publico/:linkToken: por defecto 30 por minuto por IP
RATE_PEDIDOS_LINK_LIMIT=30
RATE_PEDIDOS_LINK_TTL_MS=60000
# POST /upsell/calcular: por defecto 60 por minuto por IP
RATE_UPSELL_LIMIT=60
RATE_UPSELL_TTL_MS=60000
