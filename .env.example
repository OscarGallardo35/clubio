# ============ GENERAL ============
NODE_ENV=development

# ============ BACKEND ============
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mi_saas?schema=public
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/mi_saas?schema=public
# Conexión directa (sin pooler) usada por Prisma para las migraciones.
# En Neon: mismo DSN que DATABASE_URL pero quitando "-pooler" del host.
# En local alcanza con repetir el valor de DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mi_saas?schema=public
REDIS_URL=redis://localhost:6379

# ============ ENCRIPTACIÓN ============
ENCRYPTION_KEY=cambiar-por-32-chars-aleatorios

# ============ JWT SUPER-ADMIN ============
JWT_SUPER_ADMIN_SECRET=cambiar-en-produccion
JWT_SUPER_ADMIN_EXPIRES_IN=2h
JWT_SUPER_ADMIN_REFRESH_EXPIRES_IN=7d

# ============ SUPER-ADMIN ============
SUPER_ADMIN_INITIAL_EMAIL=admin@fideliza.app
SUPER_ADMIN_INITIAL_PASSWORD=cambiar-en-produccion

# ============ EMAIL ============
EMAIL_PROVIDER=smtp
EMAIL_FROM="Fideliza <no-reply@fideliza.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

JWT_SECRET=cambiar-en-produccion
JWT_EMPLEADO_SECRET=cambiar-en-produccion
JWT_DUENO_SECRET=cambiar-en-produccion
JWT_CLIENTE_SECRET=cambiar-en-produccion
JWT_REFRESH_SECRET=cambiar-en-produccion
JWT_EMPLEADO_EXPIRES_IN=12h
JWT_DUENO_EXPIRES_IN=7d
JWT_CLIENTE_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dominio.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PLACES_API_KEY=

# ============ PWA CLIENTE ============
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_PLACES_API_KEY=
NEXT_PUBLIC_DEFAULT_TENANT=bar-slug

# ============ PWA STAFF ============
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_DEFAULT_TENANT=bar-slug
